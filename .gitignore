# Python build / cache artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Editor swap files
*.swp
*~

# OS junk
.DS_Store
Thumbs.db

# dispatcher queue is runtime state — per-commit manifests + their index
# are written by lib/dispatcher.py and consumed by page 11 (Queue).
# The directory is created on demand; not tracked in git.
# Exception: *.example.* files are shipped seeds so page 11 + page 14 have
# something to render in a fresh checkout.
toolkit_registries/relatedness/02_queue/*
!toolkit_registries/relatedness/02_queue/plans/
!toolkit_registries/relatedness/02_queue/*.example.*
toolkit_registries/relatedness/02_queue/plans/*
!toolkit_registries/relatedness/02_queue/plans/*.example.*
