{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "cross_species_breakpoint_detection/schema_in.json",
  "title": "cross_species_breakpoint_detection input",
  "type": "object",
  "required": ["sources"],
  "additionalProperties": false,
  "properties": {
    "sources": {
      "type": "array",
      "minItems": 1,
      "description": "One row per source table or PAF. family ∈ {gene_order, sequence}. kind tells the adapter which legacy script to invoke.",
      "items": {
        "type": "object",
        "required": ["name", "family", "kind", "path"],
        "additionalProperties": false,
        "properties": {
          "name":   { "type": "string" },
          "family": { "type": "string", "enum": ["gene_order", "sequence"] },
          "kind":   { "type": "string",
                      "enum": ["wide_orthologs", "csbp_json_dir", "rideogram",
                               "paf", "bp_atlas_manifest"] },
          "path":   { "type": "string" }
        }
      }
    },
    "params": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "wfmash_p":          { "type": "number" },
        "wfmash_s":          { "type": "number" },
        "pass_a_segment_kb": { "type": "number" },
        "pass_b_segment_kb": { "type": "number" },
        "min_mapq":          { "type": "number" },
        "min_block_bp":      { "type": "number" },
        "cluster_radius_bp": { "type": "number" },
        "flank_bp":          { "type": "number" },
        "tol_kb":            { "type": "number" },
        "edge_merge_kb":     { "type": "number" },
        "divergence_tiers":  { "type": "object" }
      }
    }
  }
}
